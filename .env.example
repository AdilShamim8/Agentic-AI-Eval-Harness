# agent-eval-harness environment (all optional; the platform runs fully offline)
# Copy to .env and fill only what you use. NEVER commit real secrets.

# --- Live LLM judge (OpenAI-compatible endpoints) -------------------------
# Without these, the deterministic rubric judge is used (default, measured).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4o-mini
AEH_JUDGE_BACKEND=rubric            # rubric | live

# --- Harness behavior -------------------------------------------------------
AEH_BENCHMARKS_DIR=benchmarks       # benchmark registry directory
AEH_GATES_CONFIG=configs/gates.yaml # regression gate thresholds
AEH_PROMPTS_DIR=prompts             # versioned judge prompts
