flowchart LR
    B["Benchmark (YAML)"] --> D["Dataset JSONL<br/>+ sha256"]
    D --> R["Runner"]
    R --> C1["case: fresh env"]
    C1 --> A["agent run<br/>(network guard on)"]
    A --> T["Trajectory<br/>steps · tool calls · handoffs"]
    T --> E1["evaluators (isolated)"]
    E1 -->|"crash"| EE["EVALUATOR ERROR"]
    E1 --> V["CaseVerdict"]
    V --> M["Metrics + Wilson CI"]
    M --> G["Threshold gates"]
    M --> BASE["Baseline"]
    BASE --> RG["Regression engine"]
    RG -->|"delta < threshold"| FAIL["CI exit 1"]
    RG -->|"within threshold"| OK2["CI exit 0"]
    M --> REP["Markdown + JSON reports"]
